{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-before-stop.mjs\"",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "dyingstar": {
      "source": {
        "source": "github",
        "repo": "DyingStar-game/changelog"
      }
    }
  },
  "enabledPlugins": {
    "changelog@dyingstar": true
  }
}
